cat > .gitignore << 'EOF'
# Maven build output
**/target/
**/*.class
**/*.jar
**/*.war

# IDE files
.idea/
**/.idea/
*.iml
**/*.iml
.vscode/
.classpath
.project
.settings/

# Spring Boot sensitive configs
**/application-local.properties
**/application-dev.properties
**/.env

# OS files
.DS_Store
Thumbs.db
EOF.metadata/ 
*/target/ 
